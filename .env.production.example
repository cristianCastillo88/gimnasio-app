# ======================================================================
# GymApp - Variables de Entorno de Producción
# Copia este archivo en tu servidor como '.env' en /home/ubuntu/gimnasio-app/.env
# ======================================================================

# 1. Base de Datos PostgreSQL
POSTGRES_PASSWORD=coloca_aqui_una_clave_aleatoria_super_segura_123!

# 2. Seguridad JWT (OWASP A04: Mínimo 32 caracteres / 256 bits)
JWT_SECRET_KEY=GymApp_Super_Clave_Secreta_Produccion_2026_Minimo_32_Caracteres!

# 3. Origen del Frontend en Vercel (para CORS y enlaces de recuperación)
# Ejemplo: https://gimnasio-app.vercel.app (SIN barra final '/')
CORS_ALLOWED_ORIGIN=https://gimnasio-app.vercel.app

# 4. Configuración de Correo SMTP para Recuperación (Opcional)
# Si se deja vacío, los enlaces se registrarán en los logs del contenedor (docker logs gymapp-api)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_FROM_EMAIL=tu_correo@gmail.com
